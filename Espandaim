-- NetErrror Cheat v7.0 - Для Xenon
-- Полностью переписанный рабочий скрипт

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Настройки
local SETTINGS = {
    AIMBOT = {
        ENABLED = true,
        SMOOTHNESS = 0.12,
        FOV = 100,
        WALL_CHECK = false,
        TARGET_PART = "Head"
    },
    ESP = {
        ENABLED = true,
        BOXES = true,
        NAMES = true,
        HEALTH = true,
        MAX_DISTANCE = 1500
    }
}

-- Очистка старых ESP
for _, v in pairs(game:GetService("CoreGui"):GetChildren()) do
    if v.Name == "NetErrrorESP" then
        v:Destroy()
    end
end

-- Создаем ScreenGui для ESP
local ESPGui = Instance.new("ScreenGui")
ESPGu.Name = "NetErrrorESP"
ESPGu.Parent = game:GetService("CoreGui")
ESPGu.ResetOnSpawn = false

local ESPFolders = {}

-- Функция для ESP через ScreenGui (работает в Xenon)
function UpdateESP()
    -- Удаляем старые фреймы
    for _, folder in pairs(ESPFolders) do
        folder:Destroy()
    end
    ESPFolders = {}
    
    if not SETTINGS.ESP.ENABLED then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            local head = player.Character:FindFirstChild("Head")
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and humanoid.Health > 0 and head and root then
                local distance = (root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                if distance > SETTINGS.ESP.MAX_DISTANCE then continue end
                
                local folder = Instance.new("Folder")
                folder.Name = player.Name
                folder.Parent = ESPGui
                ESPFolders[player] = folder
                
                local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    -- Box
                    if SETTINGS.ESP.BOXES then
                        local box = Instance.new("Frame")
                        box.Name = "Box"
                        box.Size = UDim2.new(0, 60, 0, 100)
                        box.Position = UDim2.new(0, pos.X - 30, 0, pos.Y - 100)
                        box.BackgroundColor3 = Color3.new(1, 0, 0)
                        box.BackgroundTransparency = 0.7
                        box.BorderSizePixel = 1
                        box.Parent = folder
                        
                        -- Обновляем размер в зависимости от расстояния
                        local scale = 1500 / distance
                        box.Size = UDim2.new(0, scale * 2, 0, scale * 3)
                        box.Position = UDim2.new(0, pos.X - (scale * 2)/2, 0, pos.Y - (scale * 3))
                    end
                    
                    -- Name
                    if SETTINGS.ESP.NAMES then
                        local nameLabel = Instance.new("TextLabel")
                        nameLabel.Name = "Name"
                        nameLabel.Size = UDim2.new(0, 200, 0, 20)
                        nameLabel.Position = UDim2.new(0, pos.X - 100, 0, pos.Y - 120)
                        nameLabel.Text = player.Name
                        nameLabel.TextColor3 = Color3.new(1, 1, 1)
                        nameLabel.BackgroundTransparency = 1
                        nameLabel.TextSize = 14
                        nameLabel.Parent = folder
                    end
                    
                    -- Health
                    if SETTINGS.ESP.HEALTH then
                        local healthLabel = Instance.new("TextLabel")
                        healthLabel.Name = "Health"
                        healthLabel.Size = UDim2.new(0, 100, 0, 20)
                        healthLabel.Position = UDim2.new(0, pos.X - 50, 0, pos.Y - 40)
                        healthLabel.Text = "HP: " .. math.floor(humanoid.Health)
                        healthLabel.TextColor3 = Color3.new(0, 1, 0)
                        healthLabel.BackgroundTransparency = 1
                        healthLabel.TextSize = 12
                        healthLabel.Parent = folder
                    end
                end
            end
        end
    end
end

-- АИМБОТ РАБОЧАЯ ВЕРСИЯ ДЛЯ XENON
function GetClosestPlayer()
    local closest = nil
    local closestDist = math.huge
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        
        local humanoid = player.Character:FindFirstChild("Humanoid")
        local head = player.Character:FindFirstChild("Head")
        
        if humanoid and humanoid.Health > 0 and head then
            local dist = (head.Position - LocalPlayer.Character.Head.Position).Magnitude
            if dist < closestDist and dist < SETTINGS.AIMBOT.FOV then
                closestDist = dist
                closest = player
            end
        end
    end
    
    return closest
end

-- Запуск аимбота
if SETTINGS.AIMBOT.ENABLED then
    spawn(function()
        while wait(0.03) do -- 30 FPS для плавности
            if not SETTINGS.AIMBOT.ENABLED then break end
            
            local target = GetClosestPlayer()
            if target and target.Character then
                local head = target.Character:FindFirstChild("Head")
                if head then
                    local camera = workspace.CurrentCamera
                    
                    -- Плавное прицеливание
                    local startCF = camera.CFrame
                    local endCF = CFrame.new(camera.CFrame.Position, head.Position)
                    
                    for i = 0, 1, SETTINGS.AIMBOT.SMOOTHNESS do
                        if not target or not target.Character or not head then break end
                        camera.CFrame = startCF:Lerp(endCF, i)
                        wait(0.001)
                    end
                end
            end
        end
    end)
end

-- Основной цикл ESP
spawn(function()
    while wait(0.1) do -- Обновляем ESP 10 раз в секунду
        UpdateESP()
    end
end)

-- Очистка при выходе игрока
Players.PlayerRemoving:Connect(function(player)
    if ESPFolders[player] then
        ESPFolders[player]:Destroy()
        ESPFolders[player] = nil
    end
end)

-- Очистка при смене персонажа
LocalPlayer.CharacterAdded:Connect(function()
    wait(0.5)
    UpdateESP()
end)

