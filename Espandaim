print("NetErrror Cheat - ЗАПУЩЕН")
print("Аимбот: " .. (SETTINGS.AIMBOT.ENABLED and "ВКЛ" or "ВЫКЛ"))
print("ESP: " .. (SETTINGS.ESP.ENABLED and "ВКЛ" or "ВЫКЛ"))
print("Проверка стен: " .. (SETTINGS.AIMBOT.WALL_CHECK and "ВКЛ" or "ВЫКЛ"))
print("===========================================")
